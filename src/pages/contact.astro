---
import Layout from "../layouts/Layout.astro";
const raw = import.meta.env.BASE_URL;
const bp = raw.endsWith('/') ? raw.slice(0,-1) : raw;

// ── LEAD FORM ENDPOINT ───────────────────────────────────────────────────────
// Paste the Google Apps Script Web App URL here (it ends in /exec).
// Full setup steps are in FORM-SETUP.md at the project root.
const FORM_ENDPOINT = "https://script.google.com/macros/s/AKfycbztf1DpfBnDGcIjIrgrrv5U_5nzL6vOhVmNZ7vNnKw1NgZAp-hZdUcRy554XGOFeM_6GQ/exec";
// ─────────────────────────────────────────────────────────────────────────────

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": new URL(`${bp}/`, Astro.site).href },
    { "@type": "ListItem", "position": 2, "name": "Contact", "item": new URL(`${bp}/contact`, Astro.site).href },
  ],
};
const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contact QuidEdge",
  "description": "Book a free strategy call with QuidEdge.",
};

import designHtml from "../design/contact.html?raw";
const designSchema = [];
---
<Layout title="Discuss Your Branding & Content Goals | QuidEdge" fullTitle="Discuss Your Branding & Content Goals | QuidEdge" description="Tell QuidEdge about your business and goals. Online branding, content creation and business development guidance for businesses planning AUD 1,000+ monthly support." schema={designSchema}>
<Fragment set:html={designHtml}/>
<script define:vars={{ FORM_ENDPOINT }}>
    const form    = document.getElementById('lead-form');
    const success = document.getElementById('form-success');
    const errorEl = document.getElementById('form-error');
    const btn     = document.getElementById('lead-submit');

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        errorEl.hidden = true;

        // Native required-field validation first.
        if (!form.checkValidity()) { form.reportValidity(); return; }

        if (!FORM_ENDPOINT || FORM_ENDPOINT.includes('PASTE_YOUR')) {
          errorEl.textContent = 'Form is not connected yet — add your Apps Script URL in contact.astro.';
          errorEl.hidden = false;
          return;
        }

        const label = btn.querySelector('.btn-label');
        const original = label ? label.textContent : '';
        if (label) label.textContent = 'Sending…';
        btn.disabled = true;
        btn.style.opacity = '0.7';
        btn.style.cursor = 'wait';

        try {
          // no-cors: the request reaches Apps Script even though we can't read
          // the opaque response. It resolves on delivery, which is all we need.
          await fetch(FORM_ENDPOINT, {
            method: 'POST',
            body: new FormData(form),
            mode: 'no-cors',
          });
          form.hidden = true;
          success.hidden = false;
          success.scrollIntoView({ behavior: 'smooth', block: 'center' });
        } catch (err) {
          errorEl.textContent = 'Something went wrong. Please try again, or email us directly at inquiries.quidedge.au@gmail.com.';
          errorEl.hidden = false;
          if (label) label.textContent = original;
          btn.disabled = false;
          btn.style.opacity = '1';
          btn.style.cursor = '';
        }
      });
    }
  </script>
</Layout>
