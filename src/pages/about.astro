---
import Layout from "../layouts/Layout.astro";
const raw = import.meta.env.BASE_URL;
const bp = raw.endsWith('/') ? raw.slice(0,-1) : raw;

const values = [
  { num:"01", title:"Client First",            body:"We protect your brand integrity at all costs. Your audience's trust is your most valuable asset — we treat it that way." },
  { num:"02", title:"Engineer, don't guess",   body:"Every decision is backed by data. Hook rates, retention curves, CTR — we read the numbers so your instincts are informed." },
  { num:"03", title:"Speed without sacrifice", body:"85% more efficient than in-house doesn't mean we rush. It means we've built systems that deliver fast without cutting corners." },
  { num:"04", title:"Long-game thinking",      body:"Viral moments are great. A brand that compounds over years is better. We build both — the spike and the trajectory." },
];

const b0 = import.meta.env.BASE_URL.replace(/\/$/, '');
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": new URL(`${b0}/`, Astro.site).href },
    { "@type": "ListItem", "position": 2, "name": "About", "item": new URL(`${b0}/about`, Astro.site).href },
  ],
};
---
<Layout
  fullTitle="About QuidEdge | Video Editing & Branding Agency"
  title="About Us"
  description="Meet Levi & Chami — the founders behind QuidEdge, a video editing and content strategy agency serving founders and creators across the US, Australia & worldwide."
  keywords="QuidEdge founders, video editing agency about, content strategy team, Levi and Chami QuidEdge"
  schema={breadcrumbSchema}
>

  <section class="section-rule py-20 md:py-28 px-5 md:px-8">
    <div class="mx-auto max-w-7xl">
      <p class="label reveal mb-3">Our story</p>
      <h1 class="text-[clamp(2.5rem,8vw,5.5rem)] font-light leading-[0.92] tracking-[-0.04em] reveal reveal-d1">
        More Than an <span class="weight-anchor">Agency.</span>
      </h1>
    </div>
  </section>

  <!-- Founders -->
  <section class="section-rule py-20 md:py-32 px-5 md:px-8">
    <div class="mx-auto max-w-7xl grid md:grid-cols-2 gap-10 md:gap-20 items-center">
      <div class="media relative overflow-hidden bg-ink-soft reveal" style="aspect-ratio:4/5;">
        <img src={`${bp}/content/founders.jpg`}
          alt="Levi and Chami — co-founders of QuidEdge"
          class="founder-photo h-full w-full object-cover opacity-80 hover:scale-105" loading="lazy" decoding="async"/>
        <div class="absolute bottom-0 left-0 right-0 p-6"
          style="background:linear-gradient(to top,rgba(10,10,10,0.92),transparent);">
          <p class="label">Co-Founders</p>
          <p class="mt-1 font-medium text-paper">Levi &amp; Chami</p>
        </div>
      </div>
      <div class="reveal reveal-d1">
        <h2 class="text-[clamp(1.75rem,3.5vw,2.75rem)] font-light leading-[1.12] tracking-[-0.025em] mb-5">
          A family-built agency that treats your brand like its own <span class="weight-anchor">legacy.</span>
        </h2>
        <p class="text-sm text-stone leading-relaxed mb-4">
          Founded by Levi &amp; Chami — 5+ years turning entrepreneurs into digital icons. Chami leads as Creative Director; Levi drives strategy and growth. Together they've built a global team operating at a level most in-house teams can't match.
        </p>
        <p class="text-sm text-stone leading-relaxed">
          The name QuidEdge is a promise: your investment returns an <span class="font-semibold text-paper">edge</span> — in reach, authority, and results.
        </p>
        <div class="mt-9 grid grid-cols-3 gap-4 pt-8" style="border-top:1px solid rgba(138,134,128,0.13);">
          {[{n:"5+",l:"Years"},{n:"20+",l:"Editors"},{n:"173+",l:"Icon clients"}].map(s => (
            <div><p class="text-3xl font-extrabold tracking-tight">{s.n}</p><p class="label mt-1">{s.l}</p></div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="section-rule bg-ink-soft py-20 md:py-32 px-5 md:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="mb-12 reveal">
        <p class="label mb-3">How we work</p>
        <h2 class="text-[clamp(1.875rem,4vw,3rem)] font-light tracking-[-0.025em]">Our <span class="weight-anchor">Standard.</span></h2>
      </div>
      <div class="grid md:grid-cols-2 gap-px bg-stone/10">
        {values.map((v, i) => (
          <div class={`card p-8 md:p-10 reveal reveal-d${i % 2 + 1}`}>
            <p class="ghost-num" aria-hidden="true">{v.num}</p>
            <h3 class="mt-2 text-xl font-medium">{v.title}</h3>
            <p class="mt-3 text-sm text-stone leading-relaxed">{v.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Team -->
  <section class="section-rule py-20 md:py-32 px-5 md:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="mb-12 reveal">
        <p class="label mb-3">The team</p>
        <h2 class="text-[clamp(1.875rem,4vw,3rem)] font-light tracking-[-0.025em]">Global. <span class="weight-anchor">Elite.</span> Yours.</h2>
      </div>
      <div class="grid sm:grid-cols-3 gap-px bg-stone/10">
        {[
          { c:"20+", r:"Video Editors",  d:"Hand-picked across timezones. Long-form, short-form, cinematic — every style covered." },
          { c:"5",   r:"Script Writers", d:"Specialists in hook writing, storytelling, and the psychology of why people keep watching." },
          { c:"5",   r:"Ad Specialists", d:"Paid and organic. They know what converts and how to engineer it at scale." },
        ].map((t, i) => (
          <div class={`card p-8 md:p-10 reveal reveal-d${i + 1}`}>
            <p class="text-5xl font-extrabold tracking-tight">{t.c}</p>
            <p class="mt-2 font-semibold text-paper">{t.r}</p>
            <p class="mt-3 text-sm text-stone leading-relaxed">{t.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-rule py-24 md:py-36 px-5 md:px-8 text-center">
    <div class="mx-auto max-w-xl reveal">
      <h2 class="text-[clamp(2rem,5vw,3.5rem)] font-light leading-tight tracking-[-0.025em]">
        Work with a team that <span class="weight-anchor">earns it.</span>
      </h2>
      <a href={`${bp}/contact`} class="btn-primary mt-8 inline-flex">
        Book a strategy call
        <svg class="arr" width="10" height="10" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 10L10 2M10 2H4M10 2v6"/></svg>
      </a>
    </div>
  </section>
</Layout>
