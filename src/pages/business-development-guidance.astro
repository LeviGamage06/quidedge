---
import Layout from "../layouts/Layout.astro";
import "../styles/service-detail.css";
const name = "Business Development Guidance";
const description = "Review your ideal customers, offer, acquisition approach and client journey with QuidEdge. Practical guidance and clearly scoped next steps.";
const canonical = new URL("/business-development-guidance/", Astro.site).href;
const home = new URL("/", Astro.site).href;
const serviceSchema = {
  "@context": "https://schema.org", "@type": "Service",
  "@id": `${canonical}#service`, "name": name, "serviceType": name,
  "url": canonical, "description": description,
  "provider": {"@id": `${home}#organization`},
  "areaServed": ["Australia", "United States", "New Zealand", "Canada"].map(name => ({"@type":"Country",name})),
  "audience": {"@type":"Audience","audienceType":"Businesses, business owners and marketing decision-makers"}
};
const breadcrumbSchema = {
  "@context":"https://schema.org","@type":"BreadcrumbList",
  "itemListElement":[
    {"@type":"ListItem","position":1,"name":"Home","item":home},
    {"@type":"ListItem","position":2,"name":"Services","item":new URL("/services/",Astro.site).href},
    {"@type":"ListItem","position":3,"name":name,"item":canonical}
  ]
};
const faqSchema = {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "Is this a guaranteed lead-generation service?", "acceptedAnswer": {"@type": "Answer", "text": "No. Guidance helps you evaluate choices and plan action. Leads, sales and revenue depend on implementation, your offer and market conditions."}}, {"@type": "Question", "name": "Will QuidEdge run our sales operation?", "acceptedAnswer": {"@type": "Answer", "text": "Guidance does not automatically include sales execution or outsourced business operations. Any additional responsibilities must be explicitly agreed."}}, {"@type": "Question", "name": "Can this be combined with branding and content?", "acceptedAnswer": {"@type": "Answer", "text": "Yes. The guidance can inform your personal or company positioning and the content you create. Deliverables and responsibilities are agreed in the scope."}}, {"@type": "Question", "name": "Can we work with QuidEdge remotely?", "acceptedAnswer": {"@type": "Answer", "text": "Yes. QuidEdge delivers its services online. We focus on businesses in Australia, the USA, New Zealand and Canada. Share your time zone and availability so collaboration and feedback can be planned around your team."}}, {"@type": "Question", "name": "What will you need from our team?", "acceptedAnswer": {"@type": "Answer", "text": "Your goals, audience context, existing brand materials and relevant content are a useful starting point. Time for interviews, recording, feedback and approvals depends on the scope and is discussed before work begins."}}, {"@type": "Question", "name": "How are feedback and approvals handled?", "acceptedAnswer": {"@type": "Answer", "text": "Review stages, the person responsible for approval and revision arrangements should be defined in the agreed scope. Share your internal approval requirements during the initial conversation."}}]};
---
<Layout title={name} fullTitle="Practical business development guidance | QuidEdge" description={description} schema={[serviceSchema, breadcrumbSchema, faqSchema]}>
<div class="qe-service-page"><section class="qe-service-intro"><div class="max-w-7xl mx-auto px-5 md:px-8"><p class="label">Business Development Guidance</p><h1>Clear priorities for your next stage.</h1><p class="qe-market-fit">For businesses in Australia, the USA, New Zealand and Canada.</p><p class="qe-service-lead">Practical guidance for businesses reviewing their audience, offer and approach to attracting and retaining clients. Connect growth decisions to a clearer brand and a realistic action plan.</p><div class="qe-bridge-links"><a href="/contact" class="btn-primary">Discuss your goals</a><a href="/services" class="btn-secondary">All services</a></div></div></section><section class="qe-service-scope"><div class="max-w-7xl mx-auto px-5 md:px-8"><p class="label">Build your scope</p><h2>Support shaped around your business.</h2><div class="qe-scope-grid"><article><span>01</span><h3>Ideal customer clarity</h3><p>Discuss which customer groups best fit your offer, capabilities and commercial priorities.</p></article><article><span>02</span><h3>Offer and value proposition</h3><p>Review how your services are explained and what makes the offer relevant to the buyer.</p></article><article><span>03</span><h3>Acquisition direction</h3><p>Consider suitable channels and ways to start relevant business conversations.</p></article><article><span>04</span><h3>Client journey</h3><p>Map the steps from first contact to inquiry, proposal and an ongoing relationship.</p></article><article><span>05</span><h3>Business priorities</h3><p>Identify areas to investigate and sequence actions around available resources.</p></article><article><span>06</span><h3>Progress measures</h3><p>Define useful measures such as qualified inquiries, proposal outcomes and customer retention.</p></article></div></div></section><section class="qe-service-questions"><div class="max-w-7xl mx-auto px-5 md:px-8"><h2>Before we start.</h2><details><summary>Is this a guaranteed lead-generation service?</summary><p>No. Guidance helps you evaluate choices and plan action. Leads, sales and revenue depend on implementation, your offer and market conditions.</p></details><details><summary>Will QuidEdge run our sales operation?</summary><p>Guidance does not automatically include sales execution or outsourced business operations. Any additional responsibilities must be explicitly agreed.</p></details><details><summary>Can this be combined with branding and content?</summary><p>Yes. The guidance can inform your personal or company positioning and the content you create. Deliverables and responsibilities are agreed in the scope.</p></details></div></section><section class="qe-service-next"><div class="max-w-7xl mx-auto px-5 md:px-8"><h2>Tell us what your business needs next.</h2><p>We will discuss your priorities and define the proposed scope before work begins.</p><div class="qe-bridge-links"><a href="/contact" class="btn-primary">Start a conversation</a><a href="/services" class="btn-secondary">Explore our services</a></div></div></section><section class="qe-decision qe-decision-light"><div class="max-w-7xl mx-auto px-5 md:px-8"><p class="label">Fit, scope and next steps</p><h2>When you need to prioritise your next move.</h2><div class="qe-decision-grid"><article><h3>Who this can help</h3><p>A useful starting point for owners reviewing their ideal customer, value proposition, acquisition approach or client journey.</p></article><article><h3>What to agree in your proposal</h3><p>Discuss a review of your current approach, recommendations and an action-priority plan. Agree on the depth, sessions and written outputs in the proposal.</p></article><article><h3>How it connects</h3><p>Guidance can inform the audience, offer and message used in your branding and content. Execution responsibilities are defined separately.</p></article></div><div class="qe-decision-foot"><p>Services are delivered online. For ongoing support, our ideal client investment is AUD 1,000+ per month. Your quote depends on the agreed scope.</p><a class="btn-secondary" href="/services">Explore connected services</a></div></div></section><section class="qe-decision "><div class="max-w-7xl mx-auto px-5 md:px-8"><p class="label">Working together</p><h2>Plan the collaboration.</h2><div class="qe-decision-faq"><details><summary>Can we work with QuidEdge remotely?</summary><p>Yes. QuidEdge delivers its services online. We focus on businesses in Australia, the USA, New Zealand and Canada. Share your time zone and availability so collaboration and feedback can be planned around your team.</p></details><details><summary>What will you need from our team?</summary><p>Your goals, audience context, existing brand materials and relevant content are a useful starting point. Time for interviews, recording, feedback and approvals depends on the scope and is discussed before work begins.</p></details><details><summary>How are feedback and approvals handled?</summary><p>Review stages, the person responsible for approval and revision arrangements should be defined in the agreed scope. Share your internal approval requirements during the initial conversation.</p></details></div></div></section></div>
</Layout>
