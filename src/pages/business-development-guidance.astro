---
import Layout from "../layouts/Layout.astro";
import "../styles/service-detail.css";
const name = "Business Development Guidance";
const description = "Review your ideal customers, offer, acquisition approach and client journey with QuidEdge. Practical guidance and clearly scoped next steps.";
const canonical = new URL("/business-development-guidance/", Astro.site).href;
const home = new URL("/", Astro.site).href;
const serviceSchema = {
  "@context": "https://schema.org", "@type": "Service",
  "@id": `${canonical}#service`, "name": name, "serviceType": name,
  "url": canonical, "description": description,
  "provider": {"@id": `${home}#organization`},
  "areaServed": ["Australia", "United States", "New Zealand", "Canada"].map(name => ({"@type":"Country",name})),
  "audience": {"@type":"Audience","audienceType":"Businesses, business owners and marketing decision-makers"}
};
const breadcrumbSchema = {
  "@context":"https://schema.org","@type":"BreadcrumbList",
  "itemListElement":[
    {"@type":"ListItem","position":1,"name":"Home","item":home},
    {"@type":"ListItem","position":2,"name":"Services","item":new URL("/services/",Astro.site).href},
    {"@type":"ListItem","position":3,"name":name,"item":canonical}
  ]
};
const faqSchema = {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "Is this a guaranteed lead-generation service?", "acceptedAnswer": {"@type": "Answer", "text": "No. Guidance helps you evaluate choices and plan action. Leads, sales and revenue depend on implementation, your offer and market conditions."}}, {"@type": "Question", "name": "Will QuidEdge run our sales operation?", "acceptedAnswer": {"@type": "Answer", "text": "Guidance does not automatically include sales execution or outsourced business operations. Any additional responsibilities must be explicitly agreed."}}, {"@type": "Question", "name": "Can this be combined with branding and content?", "acceptedAnswer": {"@type": "Answer", "text": "Yes. The guidance can inform your personal or company positioning and the content you create. Deliverables and responsibilities are agreed in the scope."}}, {"@type": "Question", "name": "Can we work with QuidEdge remotely?", "acceptedAnswer": {"@type": "Answer", "text": "Yes. QuidEdge delivers its services online. We focus on businesses in Australia, the USA, New Zealand and Canada. Share your time zone and availability so collaboration and feedback can be planned around your team."}}, {"@type": "Question", "name": "What will you need from our team?", "acceptedAnswer": {"@type": "Answer", "text": "Your goals, audience context, existing brand materials and relevant content are a useful starting point. Time for interviews, recording, feedback and approvals depends on the scope and is discussed before work begins."}}, {"@type": "Question", "name": "How are feedback and approvals handled?", "acceptedAnswer": {"@type": "Answer", "text": "Review stages, the person responsible for approval and revision arrangements should be defined in the agreed scope. Share your internal approval requirements during the initial conversation."}}]};

import designHtml from "../design/business-development-guidance.html?raw";
const designSchema = [{"@context": "https://schema.org", "@type": "Service", "name": "Business Development Guidance", "description": "Practical guidance for businesses reviewing their audience, offer and approach to attracting and retaining clients. Connect growth decisions to a clearer brand and a realistic action plan.", "url": "https://www.quidedge.com/business-development-guidance/", "provider": {"@type": "Organization", "name": "QuidEdge", "url": "https://www.quidedge.com/"}}, {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "Is this a guaranteed lead-generation service?", "acceptedAnswer": {"@type": "Answer", "text": "No. Guidance helps you evaluate choices and plan action. Leads, sales and revenue depend on implementation, your offer and market conditions."}}, {"@type": "Question", "name": "Will QuidEdge run our sales operation?", "acceptedAnswer": {"@type": "Answer", "text": "Guidance does not automatically include sales execution or outsourced business operations. Any additional responsibilities must be explicitly agreed."}}, {"@type": "Question", "name": "Can this be combined with branding and content?", "acceptedAnswer": {"@type": "Answer", "text": "Yes. The guidance can inform your personal or company positioning and the content you create. Deliverables and responsibilities are agreed in the scope."}}]}];
---
<Layout title="Business Development Guidance | QuidEdge" fullTitle="Business Development Guidance | QuidEdge" description="Review your ideal customers, offer, acquisition approach and client journey with QuidEdge. Practical guidance and clearly scoped next steps." schema={designSchema}>
<div class="qe-service-page"><Fragment set:html={designHtml}/></div>

</Layout>
