---
import Layout from "../layouts/Layout.astro";
const raw = import.meta.env.BASE_URL;
const bp = raw.endsWith('/') ? raw.slice(0,-1) : raw;

const canonical = new URL(`${bp}/video-editing-for-creators`, Astro.site).href;
const home = new URL(`${bp}/`, Astro.site).href;

const faqs = [
  {
    q: "What type of video editing does QuidEdge provide?",
    a: "QuidEdge provides long-form YouTube editing, short-form editing and repurposing, captions, subtitles, motion graphics, lower thirds and thumbnail design, with an emphasis on pacing and audience retention."
  },
  {
    q: "Who is QuidEdge video editing for?",
    a: "The service is designed for founders, executives and creators who need a consistent production system for YouTube, TikTok, Instagram Reels, LinkedIn and other content-led channels."
  },
  {
    q: "What does retention-focused editing mean?",
    a: "Retention-focused editing means making deliberate choices about the opening hook, cuts, pacing, visual changes, sound and story progression so each moment gives the viewer a reason to continue watching."
  },
  {
    q: "Can one piece of content be adapted for multiple platforms?",
    a: "Yes. QuidEdge can adapt a core idea for different platforms, but the goal is not simple reposting. Each version can be shaped around the format, pacing and audience behaviour of the platform where it will appear."
  }
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${canonical}#service`,
  "name": "Video Editing for Creators",
  "serviceType": "Retention-Focused Video Editing",
  "url": canonical,
  "description": "Long-form and short-form video editing for founders and creators, including pacing, motion graphics, captions, repurposing and thumbnail design.",
  "provider": { "@id": `${home}#organization` },
  "audience": {
    "@type": "Audience",
    "audienceType": "Founders, executives and digital creators"
  },
  "areaServed": [
    { "@type": "Country", "name": "Australia" },
    { "@type": "Country", "name": "United States" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": home },
    { "@type": "ListItem", "position": 2, "name": "Services", "item": new URL(`${bp}/services`, Astro.site).href },
    { "@type": "ListItem", "position": 3, "name": "Video Editing for Creators", "item": canonical }
  ]
};
---
<Layout
  fullTitle="Video Editing Agency for Creators & Founders | QuidEdge"
  title="Video Editing for Creators"
  description="Retention-focused long-form and short-form video editing for creators and founders. QuidEdge combines pacing, motion, captions, repurposing and platform strategy."
  keywords="video editing agency for creators, YouTube video editing agency, short form video editing agency, video editor for creators, retention video editing, video editing for founders"
  schema={[serviceSchema, faqSchema, breadcrumbSchema]}
>
  <section class="section-rule py-20 md:py-28 px-5 md:px-8">
    <div class="mx-auto max-w-5xl">
      <p class="label reveal mb-3">Retention editing</p>
      <h1 class="text-[clamp(2.5rem,7vw,5.25rem)] font-light leading-[0.94] tracking-[-0.04em] reveal reveal-d1">
        Video Editing for <span class="weight-anchor">Creators.</span>
      </h1>
      <p class="mt-6 max-w-2xl text-sm md:text-base text-stone leading-relaxed reveal reveal-d2">
        QuidEdge edits long-form and short-form content around one principle: every second should earn the next one. The process combines storytelling, pacing, motion, sound and platform-specific creative decisions.
      </p>
      <div class="mt-8 flex flex-wrap gap-3 reveal reveal-d3">
        <a href={`${bp}/contact`} class="btn-primary">Book a strategy call</a>
        <a href={`${bp}/work`} class="btn-secondary">See the work</a>
      </div>
    </div>
  </section>

  <section class="section-rule py-16 md:py-24 px-5 md:px-8">
    <div class="mx-auto max-w-5xl grid gap-12 md:grid-cols-[0.9fr_1.1fr]">
      <div class="reveal">
        <p class="label mb-3">Why retention matters</p>
        <h2 class="text-[clamp(1.8rem,4vw,3rem)] font-light leading-tight tracking-[-0.025em]">
          Editing is not decoration. It is <span class="weight-anchor">attention design.</span>
        </h2>
      </div>
      <div class="space-y-5 text-sm text-stone leading-relaxed reveal reveal-d1">
        <p>
          Strong editing makes the story easier to follow and reduces the reasons a viewer has to leave. That starts before flashy effects: the opening needs a clear promise, the pacing needs contrast, and visual or audio changes should support the point being made.
        </p>
        <p>
          QuidEdge treats editing and strategy as one system. The cut, hook, title, thumbnail and platform format should all reinforce the same viewer expectation.
        </p>
      </div>
    </div>
  </section>

  <section class="section-rule bg-ink-soft py-16 md:py-24 px-5 md:px-8">
    <div class="mx-auto max-w-5xl">
      <p class="label mb-3 reveal">Production capabilities</p>
      <h2 class="text-[clamp(1.8rem,4vw,3rem)] font-light tracking-[-0.025em] reveal reveal-d1">
        Built for a modern content <span class="weight-anchor">pipeline.</span>
      </h2>
      <div class="mt-10 grid gap-px bg-stone/10 sm:grid-cols-2">
        {[
          ["Long-form YouTube editing", "Structure, pacing, visual changes and sound designed around sustained viewing and a coherent story."],
          ["Short-form editing", "Fast, clear edits for Shorts, Reels and TikTok that communicate the idea quickly without losing narrative context."],
          ["Content repurposing", "Turn long-form footage into platform-specific short-form assets rather than simply cropping and reposting the same cut."],
          ["Motion graphics", "Use motion, lower thirds and visual emphasis when they make the idea easier to understand or the sequence easier to follow."],
          ["Captions and subtitles", "Readable captions and subtitles that support silent viewing, accessibility and comprehension."],
          ["Thumbnail support", "Creative support for thumbnail concepts designed to align the click promise with the content viewers actually receive."]
        ].map(([h, d], i) => (
          <div class={`card p-7 md:p-9 reveal reveal-d${(i % 2) + 1}`}>
            <h3 class="text-lg font-medium mb-2">{h}</h3>
            <p class="text-sm text-stone leading-relaxed">{d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-rule py-16 md:py-24 px-5 md:px-8">
    <div class="mx-auto max-w-5xl">
      <p class="label mb-3 reveal">The retention workflow</p>
      <h2 class="text-[clamp(1.8rem,4vw,3rem)] font-light tracking-[-0.025em] reveal reveal-d1">
        Hook. Hold. <span class="weight-anchor">Deliver.</span>
      </h2>
      <ol class="mt-10 grid gap-px bg-stone/10 md:grid-cols-4">
        {[
          ["01", "Hook", "Make the opening immediately relevant to the promise of the video."],
          ["02", "Structure", "Organise the sequence so each section naturally creates a reason to continue."],
          ["03", "Edit", "Use cuts, motion, sound and visual emphasis to improve clarity and pace."],
          ["04", "Adapt", "Shape the final asset for the platform, format and viewing behaviour it is intended for."]
        ].map(([n, h, d], i) => (
          <li class={`card p-6 md:p-7 reveal reveal-d${Math.min(i + 1, 4)}`}>
            <p class="label text-proof mb-4">{n}</p>
            <h3 class="text-base font-medium mb-2">{h}</h3>
            <p class="text-xs text-stone leading-relaxed">{d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section-rule bg-ink-soft py-16 md:py-24 px-5 md:px-8">
    <div class="mx-auto max-w-5xl">
      <p class="label mb-3 reveal">Common questions</p>
      <div class="mt-6 divide-y" style="border-color:var(--line);">
        {faqs.map((f) => (
          <details class="py-5">
            <summary class="cursor-pointer text-base font-medium">{f.q}</summary>
            <p class="mt-3 max-w-3xl text-sm text-stone leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section-rule py-20 md:py-28 px-5 md:px-8 text-center">
    <div class="mx-auto max-w-xl reveal">
      <p class="label mb-4">Build a stronger content engine</p>
      <h2 class="text-[clamp(2rem,5vw,3.5rem)] font-light leading-tight tracking-[-0.025em]">
        Make every second <span class="weight-anchor">earn attention.</span>
      </h2>
      <p class="mt-4 text-sm text-stone">Talk with QuidEdge about your content volume, platforms and editing workflow.</p>
      <a href={`${bp}/contact`} class="btn-primary mt-7 inline-flex">Book a strategy call</a>
    </div>
  </section>
</Layout>
