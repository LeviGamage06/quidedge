---
import Layout from "../layouts/Layout.astro";
const raw = import.meta.env.BASE_URL;
const bp = raw.endsWith('/') ? raw.slice(0,-1) : raw;

const canonical = new URL(`${bp}/video-editing-for-creators`, Astro.site).href;
const home = new URL(`${bp}/`, Astro.site).href;

const faqs = [
  {
    q: "What type of video editing does QuidEdge provide?",
    a: "QuidEdge provides long-form YouTube editing, short-form editing and repurposing, captions, subtitles, motion graphics, lower thirds and thumbnail design, with an emphasis on pacing and audience retention."
  },
  {
    q: "Who is QuidEdge video editing for?",
    a: "The service is designed for founders, executives and creators who need a consistent production system for YouTube, TikTok, Instagram Reels, LinkedIn and other content-led channels."
  },
  {
    q: "What does retention-focused editing mean?",
    a: "Retention-focused editing means making deliberate choices about the opening hook, cuts, pacing, visual changes, sound and story progression so each moment gives the viewer a reason to continue watching."
  },
  {
    q: "Can one piece of content be adapted for multiple platforms?",
    a: "Yes. QuidEdge can adapt a core idea for different platforms, but the goal is not simple reposting. Each version can be shaped around the format, pacing and audience behaviour of the platform where it will appear."
  }
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${canonical}#service`,
  "name": "Video Editing for Creators",
  "serviceType": "Retention-Focused Video Editing",
  "url": canonical,
  "description": "Long-form and short-form video editing for founders and creators, including pacing, motion graphics, captions, repurposing and thumbnail design.",
  "provider": { "@id": `${home}#organization` },
  "audience": {
    "@type": "Audience",
    "audienceType": "Founders, executives and digital creators"
  },
  "areaServed": [
    { "@type": "Country", "name": "Australia" },
    { "@type": "Country", "name": "United States" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": home },
    { "@type": "ListItem", "position": 2, "name": "Services", "item": new URL(`${bp}/services`, Astro.site).href },
    { "@type": "ListItem", "position": 3, "name": "Video Editing for Creators", "item": canonical }
  ]
};

import designHtml from "../design/video-editing-for-creators.html?raw";
const designSchema = [];
---
<Layout title="Video Editing Agency for Creators & Founders | QuidEdge" fullTitle="Video Editing Agency for Creators & Founders | QuidEdge" description="Retention-focused long-form and short-form video editing for creators and founders. QuidEdge combines pacing, motion, captions, repurposing and platform strategy." schema={designSchema}>
<Fragment set:html={designHtml}/>

</Layout>
