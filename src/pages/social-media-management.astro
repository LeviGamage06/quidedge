const designSchema = [{"@context": "https://schema.org", "@type": "Service", "name": "Social Media Management", "description": "Social media management for businesses in Australia, the USA, New Zealand and Canada. Connect content planning, production and publishing.", "url": "https://www.quidedge.com/social-media-management/", "provider": {"@type": "Organization", "name": "QuidEdge", "url": "https://www.quidedge.com/"}, "areaServed": [{"@type": "Country", "name": "Australia"}, {"@type": "Country", "name": "United States"}, {"@type": "Country", "name": "New Zealand"}, {"@type": "Country", "name": "Canada"}], "audience": {"@type": "BusinessAudience", "audienceType": "Businesses"}}, {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "Which platforms do you support?", "acceptedAnswer": {"@type": "Answer", "text": "Discuss LinkedIn, Facebook and Instagram management with the team. YouTube and TikTok content production can be included in a wider plan when appropriate."}}, {"@type": "Question", "name": "Are all platforms included in one price?", "acceptedAnswer": {"@type": "Answer", "text": "No universal platform bundle is assumed. The proposal defines the channels, content volume, production needs and management responsibilities."}}, {"@type": "Question", "name": "Do you guarantee followers or leads?", "acceptedAnswer": {"@type": "Answer", "text": "No. Results depend on the audience, offer, starting point, content and distribution. We agree on relevant measures and review performance."}}, {"@type": "Question", "name": "Are paid ads included?", "acceptedAnswer": {"@type": "Answer", "text": "Paid advertising responsibilities, creative production and any media budget should be scoped explicitly. A social management plan does not automatically include ad spend."}}, {"@type": "Question", "name": "Can I approve posts before publishing?", "acceptedAnswer": {"@type": "Answer", "text": "The approval workflow is agreed during onboarding, including who reviews content and how revisions are handled."}}]}];
---
<Layout title="Social Media Management for Businesses | QuidEdge" fullTitle="Social Media Management for Businesses | QuidEdge" description="Social media management for businesses in Australia, the USA, New Zealand and Canada. Connect content planning, production and publishing." schema={designSchema}>
<div class="qe-service-page"><Fragment set:html={designHtml}/></div>

</Layout>
