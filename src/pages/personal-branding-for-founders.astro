---
import Layout from "../layouts/Layout.astro";
const raw = import.meta.env.BASE_URL;
const bp = raw.endsWith('/') ? raw.slice(0,-1) : raw;

const canonical = new URL(`${bp}/personal-branding-for-founders`, Astro.site).href;
const home = new URL(`${bp}/`, Astro.site).href;

const faqs = [
  {
    q: "What does personal branding for founders include?",
    a: "At QuidEdge, founder personal branding combines brand positioning, content pillars, visual language, platform strategy, bio and headline optimisation, and a repeatable content system designed around the founder's expertise and audience."
  },
  {
    q: "Who is founder personal branding best suited for?",
    a: "It is best suited for founders, executives and creator-led business leaders who want their expertise, point of view and business reputation to become easier to discover and recognise online."
  },
  {
    q: "Which platforms can a founder brand use?",
    a: "The right mix depends on the audience and content format. QuidEdge works across LinkedIn, YouTube, TikTok and Instagram Reels, adapting the same strategic positioning to each platform rather than simply reposting identical content."
  },
  {
    q: "Does personal branding guarantee virality?",
    a: "No. QuidEdge does not guarantee virality. The goal is to build a stronger brand system, improve content quality and retention, and increase the probability that useful content earns attention over time."
  }
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${canonical}#service`,
  "name": "Personal Branding for Founders",
  "serviceType": "Founder Personal Branding",
  "url": canonical,
  "description": "Personal branding strategy for founders and executives, including positioning, content pillars, visual language, platform strategy and content systems.",
  "provider": { "@id": `${home}#organization` },
  "audience": {
    "@type": "Audience",
    "audienceType": "Founders, executives and creator-led business leaders"
  },
  "areaServed": [
    { "@type": "Country", "name": "Australia" },
    { "@type": "Country", "name": "United States" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": home },
    { "@type": "ListItem", "position": 2, "name": "Services", "item": new URL(`${bp}/services`, Astro.site).href },
    { "@type": "ListItem", "position": 3, "name": "Personal Branding for Founders", "item": canonical }
  ]
};
---
<Layout
  fullTitle="Personal Branding Agency for Founders & Executives | QuidEdge"
  title="Personal Branding for Founders"
  description="Build a founder brand with clear positioning, content pillars, platform strategy and high-retention content. QuidEdge works with founders, executives and creators worldwide."
  keywords="personal branding agency for founders, founder personal branding, executive personal branding, CEO personal branding, personal branding strategy for founders"
  schema={[serviceSchema, faqSchema, breadcrumbSchema]}
>
  <section class="section-rule py-20 md:py-28 px-5 md:px-8">
    <div class="mx-auto max-w-5xl">
      <p class="label reveal mb-3">Founder personal branding</p>
      <h1 class="text-[clamp(2.5rem,7vw,5.25rem)] font-light leading-[0.94] tracking-[-0.04em] reveal reveal-d1">
        Personal Branding for <span class="weight-anchor">Founders.</span>
      </h1>
      <p class="mt-6 max-w-2xl text-sm md:text-base text-stone leading-relaxed reveal reveal-d2">
        QuidEdge helps founders and executives turn expertise into a recognisable digital brand through positioning, strategic storytelling, platform-specific content and retention-led creative execution.
      </p>
      <div class="mt-8 flex flex-wrap gap-3 reveal reveal-d3">
        <a href={`${bp}/contact`} class="btn-primary">Book a strategy call</a>
        <a href={`${bp}/work`} class="btn-secondary">View case studies</a>
        <a href={`${bp}/resources/founder-brand-scorecard/`} class="btn-secondary">Free brand scorecard</a>
      </div>
    </div>
  </section>

  <section class="section-rule py-16 md:py-24 px-5 md:px-8">
    <div class="mx-auto max-w-5xl grid gap-12 md:grid-cols-[0.9fr_1.1fr]">
      <div class="reveal">
        <p class="label mb-3">The objective</p>
        <h2 class="text-[clamp(1.8rem,4vw,3rem)] font-light leading-tight tracking-[-0.025em]">
          Make your expertise <span class="weight-anchor">easy to recognise.</span>
        </h2>
      </div>
      <div class="space-y-5 text-sm text-stone leading-relaxed reveal reveal-d1">
        <p>
          A founder brand works when people can quickly understand what you know, what you stand for and why your perspective is worth following. The goal is not to manufacture a louder persona. It is to create a clear, consistent signal around your real expertise.
        </p>
        <p>
          QuidEdge combines brand positioning with content strategy and production so the strategy does not stop at a document. The positioning informs the topics, hooks, visual language, editing style and platform distribution.
        </p>
      </div>
    </div>
  </section>

  <section class="section-rule bg-ink-soft py-16 md:py-24 px-5 md:px-8">
    <div class="mx-auto max-w-5xl">
      <p class="label mb-3 reveal">What is included</p>
      <h2 class="text-[clamp(1.8rem,4vw,3rem)] font-light tracking-[-0.025em] reveal reveal-d1">
        A complete founder-brand <span class="weight-anchor">system.</span>
      </h2>
      <div class="mt-10 grid gap-px bg-stone/10 sm:grid-cols-2">
        {[
          ["Brand positioning", "Clarify the expertise, market position, audience and point of view the founder should become known for."],
          ["Content pillars", "Build repeatable topic areas that connect the founder's expertise to the questions and problems the audience actually cares about."],
          ["Platform strategy", "Define where the founder should show up, what formats fit each platform and how often content should be distributed."],
          ["Visual language", "Create a consistent visual direction so posts and videos are recognisable without relying on a logo in every frame."],
          ["Retention-led production", "Use hooks, pacing, edits, motion and storytelling choices designed to keep the audience engaged from the opening seconds."],
          ["Performance iteration", "Review what earns attention, where viewers drop, and which themes produce the strongest response so the system can improve over time."]
        ].map(([h, d], i) => (
          <div class={`card p-7 md:p-9 reveal reveal-d${(i % 2) + 1}`}>
            <h3 class="text-lg font-medium mb-2">{h}</h3>
            <p class="text-sm text-stone leading-relaxed">{d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-rule py-16 md:py-24 px-5 md:px-8">
    <div class="mx-auto max-w-5xl">
      <p class="label mb-3 reveal">How QuidEdge approaches it</p>
      <h2 class="text-[clamp(1.8rem,4vw,3rem)] font-light tracking-[-0.025em] reveal reveal-d1">
        Strategy first. Distribution <span class="weight-anchor">second.</span>
      </h2>
      <ol class="mt-10 grid gap-px bg-stone/10 md:grid-cols-4">
        {[
          ["01", "Position", "Define the audience, expertise, category and point of view."],
          ["02", "Systemise", "Turn the position into content pillars, formats and repeatable ideas."],
          ["03", "Produce", "Create platform-native content with retention-focused editing and storytelling."],
          ["04", "Learn", "Use performance data to refine hooks, topics, formats and distribution."]
        ].map(([n, h, d], i) => (
          <li class={`card p-6 md:p-7 reveal reveal-d${Math.min(i + 1, 4)}`}>
            <p class="label text-proof mb-4">{n}</p>
            <h3 class="text-base font-medium mb-2">{h}</h3>
            <p class="text-xs text-stone leading-relaxed">{d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section-rule bg-ink-soft py-16 md:py-24 px-5 md:px-8">
    <div class="mx-auto max-w-5xl">
      <p class="label mb-3 reveal">Questions founders ask</p>
      <div class="mt-6 divide-y" style="border-color:var(--line);">
        {faqs.map((f) => (
          <details class="py-5">
            <summary class="cursor-pointer text-base font-medium">{f.q}</summary>
            <p class="mt-3 max-w-3xl text-sm text-stone leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section-rule py-20 md:py-28 px-5 md:px-8 text-center">
    <div class="mx-auto max-w-xl reveal">
      <p class="label mb-4">Build the signal</p>
      <h2 class="text-[clamp(2rem,5vw,3.5rem)] font-light leading-tight tracking-[-0.025em]">
        Turn expertise into <span class="weight-anchor">authority.</span>
      </h2>
      <p class="mt-4 text-sm text-stone">Start with a free strategy conversation about your positioning, audience and content system.</p>
      <a href={`${bp}/contact`} class="btn-primary mt-7 inline-flex">Book a strategy call</a>
    </div>
  </section>
</Layout>
