---
import Layout from "../layouts/Layout.astro";
const raw = import.meta.env.BASE_URL;
const bp = raw.endsWith('/') ? raw.slice(0,-1) : raw;

const canonical = new URL(`${bp}/personal-branding-for-founders`, Astro.site).href;
const home = new URL(`${bp}/`, Astro.site).href;

const faqs = [
  {
    q: "What does personal branding for founders include?",
    a: "At QuidEdge, founder personal branding combines brand positioning, content pillars, visual language, platform strategy, bio and headline optimisation, and a repeatable content system designed around the founder's expertise and audience."
  },
  {
    q: "Who is founder personal branding best suited for?",
    a: "It is best suited for founders, executives and creator-led business leaders who want their expertise, point of view and business reputation to become easier to discover and recognise online."
  },
  {
    q: "Which platforms can a founder brand use?",
    a: "The right mix depends on the audience and content format. QuidEdge works across LinkedIn, YouTube, TikTok and Instagram Reels, adapting the same strategic positioning to each platform rather than simply reposting identical content."
  },
  {
    q: "Does personal branding guarantee virality?",
    a: "No. QuidEdge does not guarantee virality. The goal is to build a stronger brand system, improve content quality and retention, and increase the probability that useful content earns attention over time."
  }
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${canonical}#service`,
  "name": "Personal Branding for Founders",
  "serviceType": "Founder Personal Branding",
  "url": canonical,
  "description": "Personal branding strategy for founders and executives, including positioning, content pillars, visual language, platform strategy and content systems.",
  "provider": { "@id": `${home}#organization` },
  "audience": {
    "@type": "Audience",
    "audienceType": "Founders, executives and creator-led business leaders"
  },
  "areaServed": [
    { "@type": "Country", "name": "Australia" },
    { "@type": "Country", "name": "United States" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": home },
    { "@type": "ListItem", "position": 2, "name": "Services", "item": new URL(`${bp}/services`, Astro.site).href },
    { "@type": "ListItem", "position": 3, "name": "Personal Branding for Founders", "item": canonical }
  ]
};

import designHtml from "../design/personal-branding-for-founders.html?raw";
const designSchema = [];
---
<Layout title="Personal Branding for Founders & Business Owners | QuidEdge" fullTitle="Personal Branding for Founders & Business Owners | QuidEdge" description="Clarify your expertise, positioning, profile and content direction with QuidEdge. Personal branding for founders, owners and executives." schema={designSchema}>
<Fragment set:html={designHtml}/>

</Layout>
