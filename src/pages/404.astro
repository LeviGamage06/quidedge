---
import Layout from "../layouts/Layout.astro";
const raw = import.meta.env.BASE_URL;
const bp = raw.endsWith('/') ? raw.slice(0,-1) : raw;
---
<Layout
  fullTitle="Page not found | QuidEdge"
  title="Page not found"
  description="The page you're looking for doesn't exist. Head back to QuidEdge — video editing and personal branding for founders and creators."
>
  <section class="section-rule flex min-h-[70vh] items-center px-5 md:px-8">
    <div class="mx-auto max-w-2xl text-center reveal visible">
      <p class="label mb-4">Error 404</p>
      <h1 class="text-[clamp(3.5rem,14vw,9rem)] font-light leading-[0.9] tracking-[-0.05em]">
        Lost the <span class="weight-anchor">Edge</span>?
      </h1>
      <p class="mt-6 text-sm text-stone max-w-sm mx-auto">
        This page doesn't exist — but your growth still can. Let's get you back on track.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={`${bp}/`} class="btn-primary">
          Back to home
          <svg class="arr" width="10" height="10" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 10L10 2M10 2H4M10 2v6"/></svg>
        </a>
        <a href={`${bp}/work`} class="btn-secondary">See our work</a>
      </div>
    </div>
  </section>
</Layout>
