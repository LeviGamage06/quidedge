---
import Layout from "../layouts/Layout.astro";
import "../styles/service-detail.css";
const name = "Company Branding";
const description = "Align your company positioning, messaging, visual direction and content foundations. Explore scope, fit and the next step with QuidEdge.";
const canonical = new URL("/business-branding/", Astro.site).href;
const home = new URL("/", Astro.site).href;
const serviceSchema = {
  "@context": "https://schema.org", "@type": "Service",
  "@id": `${canonical}#service`, "name": name, "serviceType": name,
  "url": canonical, "description": description,
  "provider": {"@id": `${home}#organization`},
  "areaServed": ["Australia", "United States", "New Zealand", "Canada"].map(name => ({"@type":"Country",name})),
  "audience": {"@type":"Audience","audienceType":"Businesses, business owners and marketing decision-makers"}
};
const breadcrumbSchema = {
  "@context":"https://schema.org","@type":"BreadcrumbList",
  "itemListElement":[
    {"@type":"ListItem","position":1,"name":"Home","item":home},
    {"@type":"ListItem","position":2,"name":"Services","item":new URL("/services/",Astro.site).href},
    {"@type":"ListItem","position":3,"name":name,"item":canonical}
  ]
};
const faqSchema = {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "What is included in company branding?", "acceptedAnswer": {"@type": "Answer", "text": "The scope can combine positioning, messaging, visual direction, content pillars and social profile alignment. Specific deliverables are agreed in your proposal."}}, {"@type": "Question", "name": "Is this only a logo project?", "acceptedAnswer": {"@type": "Answer", "text": "No. The focus is the relationship between your audience, offer, message and presentation. Visual identity is one part of that system."}}, {"@type": "Question", "name": "Can you manage content after the branding work?", "acceptedAnswer": {"@type": "Answer", "text": "Yes. Content creation and social media management can be discussed as a follow-on engagement, with platforms, volume and responsibilities agreed separately."}}, {"@type": "Question", "name": "How much does it cost?", "acceptedAnswer": {"@type": "Answer", "text": "Pricing depends on the research, strategy, identity and execution you need. We define the scope and quote before work begins."}}, {"@type": "Question", "name": "Will branding guarantee more sales?", "acceptedAnswer": {"@type": "Answer", "text": "No. Branding can improve how clearly you communicate your value. Sales also depend on demand, your offer, distribution, pricing and the customer experience."}}, {"@type": "Question", "name": "Can we work with QuidEdge remotely?", "acceptedAnswer": {"@type": "Answer", "text": "Yes. QuidEdge delivers its services online. We focus on businesses in Australia, the USA, New Zealand and Canada. Share your time zone and availability so collaboration and feedback can be planned around your team."}}, {"@type": "Question", "name": "What will you need from our team?", "acceptedAnswer": {"@type": "Answer", "text": "Your goals, audience context, existing brand materials and relevant content are a useful starting point. Time for interviews, recording, feedback and approvals depends on the scope and is discussed before work begins."}}, {"@type": "Question", "name": "How are feedback and approvals handled?", "acceptedAnswer": {"@type": "Answer", "text": "Review stages, the person responsible for approval and revision arrangements should be defined in the agreed scope. Share your internal approval requirements during the initial conversation."}}]};

import designHtml from "../design/business-branding.html?raw";
const designSchema = [{"@context": "https://schema.org", "@type": "Service", "name": "Company Branding", "description": "Company branding and positioning for businesses in Australia, the USA, New Zealand and Canada. Connect your message, visual identity and content.", "url": "https://www.quidedge.com/business-branding/", "provider": {"@type": "Organization", "name": "QuidEdge", "url": "https://www.quidedge.com/"}, "areaServed": [{"@type": "Country", "name": "Australia"}, {"@type": "Country", "name": "United States"}, {"@type": "Country", "name": "New Zealand"}, {"@type": "Country", "name": "Canada"}], "audience": {"@type": "BusinessAudience", "audienceType": "Businesses"}}, {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "What is included in company branding?", "acceptedAnswer": {"@type": "Answer", "text": "The scope can combine positioning, messaging, visual direction, content pillars and social profile alignment. Specific deliverables are agreed in your proposal."}}, {"@type": "Question", "name": "Is this only a logo project?", "acceptedAnswer": {"@type": "Answer", "text": "No. The focus is the relationship between your audience, offer, message and presentation. Visual identity is one part of that system."}}, {"@type": "Question", "name": "Can you manage content after the branding work?", "acceptedAnswer": {"@type": "Answer", "text": "Yes. Content creation and social media management can be discussed as a follow-on engagement, with platforms, volume and responsibilities agreed separately."}}, {"@type": "Question", "name": "How much does it cost?", "acceptedAnswer": {"@type": "Answer", "text": "Pricing depends on the research, strategy, identity and execution you need. We define the scope and quote before work begins."}}, {"@type": "Question", "name": "Will branding guarantee more sales?", "acceptedAnswer": {"@type": "Answer", "text": "No. Branding can improve how clearly you communicate your value. Sales also depend on demand, your offer, distribution, pricing and the customer experience."}}]}];
---
<Layout title="Company Branding & Positioning for Businesses | QuidEdge" fullTitle="Company Branding & Positioning for Businesses | QuidEdge" description="Align your company positioning, messaging, visual direction and content foundations. Explore scope, fit and the next step with QuidEdge." schema={designSchema}>
<div class="qe-service-page"><Fragment set:html={designHtml}/></div>

</Layout>
