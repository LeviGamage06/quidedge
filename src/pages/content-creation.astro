---
import Layout from "../layouts/Layout.astro";
import "../styles/service-detail.css";
const name = "Content Creation";
const description = "Connect copy, branded visuals and video around your audience and message. Explore content scope, feedback, delivery and pricing factors.";
const canonical = new URL("/content-creation/", Astro.site).href;
const home = new URL("/", Astro.site).href;
const serviceSchema = {
  "@context": "https://schema.org", "@type": "Service",
  "@id": `${canonical}#service`, "name": name, "serviceType": name,
  "url": canonical, "description": description,
  "provider": {"@id": `${home}#organization`},
  "areaServed": ["Australia", "United States", "New Zealand", "Canada"].map(name => ({"@type":"Country",name})),
  "audience": {"@type":"Audience","audienceType":"Businesses, business owners and marketing decision-makers"}
};
const breadcrumbSchema = {
  "@context":"https://schema.org","@type":"BreadcrumbList",
  "itemListElement":[
    {"@type":"ListItem","position":1,"name":"Home","item":home},
    {"@type":"ListItem","position":2,"name":"Services","item":new URL("/services/",Astro.site).href},
    {"@type":"ListItem","position":3,"name":name,"item":canonical}
  ]
};
const faqSchema = {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "Is content creation only video editing?", "acceptedAnswer": {"@type": "Answer", "text": "No. The scope can combine copy, branded visuals, scripts and video content according to your audience and goals."}}, {"@type": "Question", "name": "Is social media management included?", "acceptedAnswer": {"@type": "Answer", "text": "It can be discussed alongside production. The proposal defines whether publishing, account management and community responsibilities are included."}}, {"@type": "Question", "name": "How do you price the work?", "acceptedAnswer": {"@type": "Answer", "text": "Pricing depends on formats, volume, production complexity and review requirements. QuidEdge primarily serves businesses planning to invest AUD 1,000+ per month; this is not a fixed package price."}}, {"@type": "Question", "name": "Can we work with QuidEdge remotely?", "acceptedAnswer": {"@type": "Answer", "text": "Yes. QuidEdge delivers its services online. We focus on businesses in Australia, the USA, New Zealand and Canada. Share your time zone and availability so collaboration and feedback can be planned around your team."}}, {"@type": "Question", "name": "What will you need from our team?", "acceptedAnswer": {"@type": "Answer", "text": "Your goals, audience context, existing brand materials and relevant content are a useful starting point. Time for interviews, recording, feedback and approvals depends on the scope and is discussed before work begins."}}, {"@type": "Question", "name": "How are feedback and approvals handled?", "acceptedAnswer": {"@type": "Answer", "text": "Review stages, the person responsible for approval and revision arrangements should be defined in the agreed scope. Share your internal approval requirements during the initial conversation."}}]};

import designHtml from "../design/content-creation.html?raw";
const designSchema = [{"@context": "https://schema.org", "@type": "Service", "name": "Content Creation", "description": "Create useful, recognisable content around your company or personal brand. Start with the audience, message and channel, then build a production scope that supports them.", "url": "https://www.quidedge.com/content-creation/", "provider": {"@type": "Organization", "name": "QuidEdge", "url": "https://www.quidedge.com/"}}, {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "Is content creation only video editing?", "acceptedAnswer": {"@type": "Answer", "text": "No. The scope can combine copy, branded visuals, scripts and video content according to your audience and goals."}}, {"@type": "Question", "name": "Is social media management included?", "acceptedAnswer": {"@type": "Answer", "text": "It can be discussed alongside production. The proposal defines whether publishing, account management and community responsibilities are included."}}, {"@type": "Question", "name": "How do you price the work?", "acceptedAnswer": {"@type": "Answer", "text": "Pricing depends on formats, volume, production complexity and review requirements. QuidEdge primarily serves businesses planning to invest AUD 1,000+ per month; this is not a fixed package price."}}]}];
---
<Layout title="Content Creation for Business Brands | QuidEdge" fullTitle="Content Creation for Business Brands | QuidEdge" description="Connect copy, branded visuals and video around your audience and message. Explore content scope, feedback, delivery and pricing factors." schema={designSchema}>
<div class="qe-service-page"><Fragment set:html={designHtml}/></div>

</Layout>
